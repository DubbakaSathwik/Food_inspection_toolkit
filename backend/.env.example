# CRATE-SCAN backend configuration. Copy to backend/.env and fill in real values.
# NEVER commit .env. All values here are server-only secrets or settings (none go to the browser).

# --- Environment -----------------------------------------------------------------
# development | test | production   (the fake AI provider is refused in production)
APP_ENV=development
LOG_LEVEL=INFO

# --- MongoDB Atlas (C1 free cluster) -------------------------------------------------
# Atlas → Database → Connect → Drivers. Use a dedicated user with readWrite on this DB only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=crate-scan
# Local Docker alternative: mongodb://localhost:27017/?directConnection=true
MONGODB_DB_NAME=crate_scan_dev

# --- Firebase Authentication (Google sign-in only) -----------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the WHOLE JSON on one line (keep the quotes). Leave empty when using the Auth emulator.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local development / tests only: use the Firebase Auth emulator instead of real Firebase.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# First Super Admin (D-08): this verified Google email becomes super_admin on first sign-in.
SUPER_ADMIN_EMAIL=you@example.com

# --- HTTP ---------------------------------------------------------------------------
# Comma-separated frontend origins allowed by CORS (no wildcard in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-site.netlify.app
MAX_UPLOAD_MB=12
RATE_LIMIT_DEFAULT=240/minute
RATE_LIMIT_AI=12/minute
RATE_LIMIT_WRITE=60/minute

# --- AI providers (D-05): tried in this order; providers without a key are skipped ----------------
# Use "fake" (development/test only) to run the whole workflow without keys.
AI_PROVIDER_ORDER=gemini,nvidia,huggingface
AI_TIMEOUT_SECONDS=60

# Google AI Studio → Get API key (free tier). Model alias avoids hard-coding a retiring version.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# build.nvidia.com → API key (free credits). Vision model accepting one image per request.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_MAX_IMAGE_KB=180
# Nemotron models: turn off step-by-step reasoning (faster, no wasted tokens). Set false to allow thinking.
NVIDIA_DISABLE_THINKING=true

# huggingface.co → Settings → Access Tokens (Inference Providers permission).
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# PaddleOCR fallback (D-06): requires `uv sync --extra ocr` and ~1 GB RAM. Keep false on Render free.
OCR_ENABLED=false

# --- Defaults for admin-editable limits (Admin → Settings → Limits & Usage overrides these) ----------
AI_DAILY_LIMIT_PER_USER=60
PHOTO_RETENTION_DAYS=7
