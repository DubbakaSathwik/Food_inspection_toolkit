# CRATE-SCAN frontend — browser-safe values only (everything here ends up in the JS bundle).
# Never put server secrets (MongoDB URI, AI keys, service-account JSON) in this file.

# FastAPI backend base URL (no trailing slash). Render example: https://crate-scan-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Firebase console → Project settings → Your apps → Web app config (public by design).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development / tests only: use the Firebase Auth emulator (never "true" in production).
NEXT_PUBLIC_USE_AUTH_EMULATOR=false
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
